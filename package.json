{
  "name": "totalwork-hh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:pages": "tsc --noEmit --module esnext --moduleResolution bundler --target es2022 --lib es2022,dom --jsx react-jsx --skipLibCheck web/main.tsx web/App.tsx web/api.ts",
    "typecheck:worker": "tsc --noEmit --module esnext --moduleResolution bundler --target es2022 --lib es2022,dom --skipLibCheck worker/index.ts worker/sheets.ts",
    "dev:pages": "vite --config vite.pages.config.ts --port 5173",
    "build:pages": "vite build --config vite.pages.config.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "deploy:wrangler": "wrangler deploy --config wrangler.jsonc",
    "start:vinext": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "@vinext/cloudflare": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vinext": "^1.1.0",
    "vite": "8.3.0",
    "wrangler": "^4.0.0",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@cloudflare/vite-plugin": "beta",
    "cf": "latest"
  },
  "type": "module"
}
