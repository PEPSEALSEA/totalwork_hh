{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totalwork-hh",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "AUTH_DISCORD_ID",
      "AUTH_DISCORD_SECRET",
      "GOOGLE_SHEET_ID",
      "GOOGLE_SERVICE_ACCOUNT_EMAIL",
      "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY"
    ]
  },
  "workers_dev": true
}
